        if (!targetMesh.visible) {
            targetMesh.visible = true;
            if (targetMesh.userData.origPos) {
                targetMesh.position.copy(targetMesh.userData.origPos);
            }
        }
        selectPart(partId, targetMesh);
        document.getElementById('parts-list-panel').classList.remove('list-panel-open');
      }
    }

    function playStep(stepIndex) {
      currentStep = stepIndex;
      if (isExploded) toggleExplodedView(); 
      document.getElementById('pasos-list-panel').classList.remove('list-panel-open');
      resetSelection();

      const partsToShow = [];
      const partsToAnimate = [];

      for(let i = 0; i <= stepIndex; i++) {
        if(i === stepIndex) partsToAnimate.push(...assemblySteps[i].parts);
        else partsToShow.push(...assemblySteps[i].parts);
      }

      headboardGroup.traverse((child) => {
        if (child.isMesh && child.userData.origPos) {
          const pid = child.userData.partId;
          if (partsToAnimate.includes(pid)) {
            child.visible = true;
            child.position.set(child.userData.origPos.x, child.userData.origPos.y + 1.5, child.userData.origPos.z);
            child.userData.animTarget = child.userData.origPos.clone();
          } else if (partsToShow.includes(pid)) {
            child.visible = true;
            child.position.copy(child.userData.origPos);
            child.userData.animTarget = null;
          } else {
            child.visible = false;
            child.userData.animTarget = null;
          }
        }
      });
    }

    function init3D() {
      const container = document.getElementById('canvas-container');
      const width = container.clientWidth;
      const height = container.clientHeight;

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0a0b0e);

      camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 1000);
      camera.position.set(0, 1.8, 5.5);

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.maxPolarAngle = Math.PI / 2 + 0.05;
      controls.minDistance = 1.0;
      controls.maxDistance = 10;
      controls.target.set(0, 0.5, 0);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
      scene.add(ambientLight);
      const dirLight = new THREE.DirectionalLight(0xfff5e6, 1.2);
      dirLight.position.set(3, 5, 4);
      dirLight.castShadow = true;
      scene.add(dirLight);

      const gridHelper = new THREE.GridHelper(6, 20, 0xd4af37, 0x222633);
      gridHelper.position.y = 0;
      scene.add(gridHelper);

      buildFurnitureModel();

      window.addEventListener('resize', onWindowResize);
      setupMobileInteraction(container);

      animate();
    }

    function setupMobileInteraction(container) {
      let pressTimer;
      let isPressing = false;

      container.addEventListener('pointerdown', (e) => {
        const partsPanel = document.getElementById('parts-list-panel');
        const pasosPanel = document.getElementById('pasos-list-panel');
        if(partsPanel.classList.contains('list-panel-open') && e.clientY > 100) partsPanel.classList.remove('list-panel-open');
        if(pasosPanel.classList.contains('list-panel-open') && e.clientY > 100) pasosPanel.classList.remove('list-panel-open');

        isPressing = true;
        const rect = renderer.domElement.getBoundingClientRect();
        mouse.x = ( (e.clientX - rect.left) / rect.width ) * 2 - 1;
        mouse.y = - ( (e.clientY - rect.top) / rect.height ) * 2 + 1;

        pressTimer = setTimeout(() => {
            if (isPressing) executeRaycast();
        }, 500); 
      });

      container.addEventListener('pointermove', () => { isPressing = false; clearTimeout(pressTimer); });
      container.addEventListener('pointerup', () => { isPressing = false; clearTimeout(pressTimer); });
      container.addEventListener('pointercancel', () => { isPressing = false; clearTimeout(pressTimer); });
    }

    function executeRaycast() {
      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(headboardGroup.children, true);
      if (intersects.length > 0) {
        const object = intersects[0].object;
        const partId = object.userData.partId;
        if(partId && partId > 0 && object.visible) selectPart(partId, object);
      }
    }

    function buildFurnitureModel() {
      headboardGroup = new THREE.Group();
      scene.add(headboardGroup);

      // Materiales fieles al diseño
      const melaminaGrisMat = new THREE.MeshStandardMaterial({ color: 0x6e6e6e, roughness: 0.6 });
      const melaminaMaderaMat = new THREE.MeshStandardMaterial({ color: 0xd2b48c, roughness: 0.5 });
      const mdfMat = new THREE.MeshStandardMaterial({ color: 0xeedda5 });
      const metalMat = new THREE.MeshStandardMaterial({ color: 0xcccccc, metalness: 0.8 });

      function createBox(w, h, d, x, y, z, mat, partId) {
        const geo = new THREE.BoxGeometry(w, h, d);
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(x, y, z);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        mesh.userData = { partId: partId, origPos: new THREE.Vector3(x, y, z), defaultMat: mat, animTarget: null };
        return mesh;
      }

      // Constantes de dimensiones base (metros)
      const esp = 0.018; // espesor melamina 18mm
      const gapFront = 0.009; // mitad del espesor para alinear

      // 1. RESPALDOS VERTICALES (Grises, atras, a piso)
      // Ancho 550, Alto 950. Cama 1350 libre.
      const posXV1 = -0.675 - (0.55/2); // Izquierdo
      const posXV2 =  0.675 + (0.55/2); // Derecho
      headboardGroup.add(createBox(0.55, 0.95, esp, posXV1, 0.95/2, -gapFront, melaminaGrisMat, 1));
      headboardGroup.add(createBox(0.55, 0.95, esp, posXV2, 0.95/2, -gapFront, melaminaGrisMat, 1));

      // 2. RESPALDOS HORIZONTALES (Madera, frente a las verticales)
      // Ancho 1350, Alto 250.
      // Top board top at 1050, bottom at 800.
      headboardGroup.add(createBox(1.35, 0.25, esp, 0, 0.925, gapFront, melaminaMaderaMat, 2));
      // Bottom board top at 750, bottom at 500.
      headboardGroup.add(createBox(1.35, 0.25, esp, 0, 0.625, gapFront, melaminaMaderaMat, 2));

      // Función para armar velador (Cajonero)
      function buildNightstand(xBase, sign) {
        const group = new THREE.Group();
        const baseZ = 0; // Pegado al respaldo
        
        // 3. LATERAL CAJONERO (482x400)
        // Están dentro de los 450mm totales
        const lateralX1 = xBase - sign*(0.45/2 - 0.009);
        const lateralX2 = xBase + sign*(0.45/2 - 0.009);
        group.add(createBox(esp, 0.482, 0.40, lateralX1, 0.482/2, 0.20, melaminaGrisMat, 3));
        group.add(createBox(esp, 0.482, 0.40, lateralX2, 0.482/2, 0.20, melaminaGrisMat, 3));
        
        // 4. TECHO CAJONERO (450x400)
        // Sobre los laterales
        group.add(createBox(0.45, esp, 0.40, xBase, 0.491, 0.20, melaminaGrisMat, 4));

        // 9. REPISA BAJA (414x380)
        // Entre laterales. Y = 15cm
        group.add(createBox(0.414, esp, 0.38, xBase, 0.15, 0.21, melaminaGrisMat, 9));

        // 7. TAPA DE CAJON (444x144) - Overlay frontal
        // Tapa sobre los bordes, con 3mm juego.
        const tapaY = 0.482 - (0.144/2) - 0.002;
        group.add(createBox(0.444, 0.144, esp, xBase, tapaY, 0.409, melaminaGrisMat, 7));
        
        // Jalador (Accesorio Visual)
        group.add(createBox(0.12, 0.015, 0.02, xBase, tapaY, 0.425, metalMat, 0));

        // CAJON INTERNO
        const cX = xBase;
        const cY = tapaY;
        const cZ = 0.40 - esp - (0.35/2); // Profundidad 350

        // 5. LATERAL DE CAJON (350x100)
        const cajLatXL = cX - (0.352/2 + 0.009);
        const cajLatXR = cX + (0.352/2 + 0.009);
        group.add(createBox(esp, 0.10, 0.35, cajLatXL, cY, cZ, melaminaGrisMat, 5));
        group.add(createBox(esp, 0.10, 0.35, cajLatXR, cY, cZ, melaminaGrisMat, 5));

        // 6. FRENTE DE CAJON (352x100) - Interno
        const cajFrenteZFront = 0.40 - esp - gapFront;
        const cajFrenteZBack = 0.40 - esp - 0.35 + gapFront;
        group.add(createBox(0.352, 0.10, esp, cX, cY, cajFrenteZFront, melaminaGrisMat, 6));
        group.add(createBox(0.352, 0.10, esp, cX, cY, cajFrenteZBack, melaminaGrisMat, 6));

        // 8. FONDO DE CAJON (328x366 MDF 3mm)
        // Posicionado en el fondo con su ranura
        group.add(createBox(0.366, 0.003, 0.328, cX, cY - 0.03, cZ, mdfMat, 8));

        return group;
      }

      // Añadir ambos veladores
      const nightstandPos = 0.675 + (0.45/2); // 0.90
      headboardGroup.add(buildNightstand(-nightstandPos, -1)); // Izquierdo
      headboardGroup.add(buildNightstand(nightstandPos, 1));   // Derecho
    }

    function selectPart(partId, clickedMesh) {
      headboardGroup.traverse((child) => {
        if (child.isMesh && child.userData.defaultMat && child.visible) {
          if (child.userData.partId === partId) {
            child.material = new THREE.MeshStandardMaterial({ color: 0xffd700, emissive: 0x856404, roughness: 0.2 });
          } else {
            child.material = new THREE.MeshStandardMaterial({ color: 0x333333, transparent: true, opacity: 0.40 });
          }
        }
      });

      const data = partsData[partId];
      if (data) {
        document.getElementById('info-id-badge').innerText = data.id;
        document.getElementById('info-name').innerText = data.name;
        document.getElementById('info-qty').innerText = "x" + data.cant;
        
        document.getElementById('info-l').innerText = data.l + " mm";
        document.getElementById('info-a').innerText = data.a + " mm";
        document.getElementById('info-e').innerText = data.esp + " mm";
        
        document.getElementById('info-tap').innerText = data.tap;
        document.getElementById('part-info-card').classList.add('info-card-visible');
      }

      const bbox = new THREE.Box3().setFromObject(clickedMesh);
      const center = new THREE.Vector3();
      bbox.getCenter(center);
      targetLookAt.copy(center);
    }

    function resetSelection() {
      headboardGroup.traverse((child) => {
        if (child.isMesh && child.userData.defaultMat) {
          child.material = child.userData.defaultMat;
          child.material.opacity = 1.0;
          child.material.transparent = false;
        }
      });
      document.getElementById('part-info-card').classList.remove('info-card-visible');
      targetLookAt.set(0, 0.5, 0);
    }

    function reset3DView() {
      resetSelection();
      currentStep = -1;
      camera.position.set(0, 1.8, 5.5);
      document.getElementById('parts-list-panel').classList.remove('list-panel-open');
      document.getElementById('pasos-list-panel').classList.remove('list-panel-open');
      if (isExploded) toggleExplodedView();

      headboardGroup.traverse((child) => {
        if (child.isMesh && child.userData.origPos) {
          child.visible = true;
          child.position.copy(child.userData.origPos);
          child.userData.animTarget = null;
        }
      });
    }

    function animate() {
      requestAnimationFrame(animate);
      controls.target.lerp(targetLookAt, 0.08);
      controls.update();

      if(headboardGroup) {
        headboardGroup.traverse((child) => {
          if (child.isMesh && child.userData.animTarget) {
            child.position.lerp(child.userData.animTarget, 0.12);
            if (child.position.distanceTo(child.userData.animTarget) < 0.01) {
              child.position.copy(child.userData.animTarget);
              child.userData.animTarget = null;
            }
          }
        });
      }

      renderer.render(scene, camera);
    }

    function onWindowResize() {
      const container = document.getElementById('canvas-container');
      if (!container) return;
      const width = container.clientWidth;
      const height = container.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }

    function toggleExplodedView() {
      isExploded = !isExploded;
      currentStep = -1;
      const btn = document.getElementById('btn-explode');
      btn.classList.toggle('bg-gold-500', isExploded);
      btn.classList.toggle('text-dark-900', isExploded);
      resetSelection();

      headboardGroup.traverse((child) => {
        if (child.isMesh && child.userData.origPos) {
          child.visible = true;
          child.userData.animTarget = null;
          
          const orig = child.userData.origPos;
          if (isExploded) {
            const pId = child.userData.partId;
            let offset = new THREE.Vector3(0, 0, 0);
            
            // Lógica de separación de piezas
            if (pId === 1) offset.set(0, 0, -0.2); // Respaldos V.
            if (pId === 2) offset.set(0, 0.25, 0.3); // Respaldos H.
            if (pId === 3 || pId === 4 || pId === 9) offset.set((orig.x < 0 ? -0.1 : 0.1), 0, 0); // Caja externa
            if (pId === 8 || pId === 6 || pId === 7 || pId === 5 || pId === 0) offset.set(0, 0.15, 0.3); // Cajón
            
            child.position.set(orig.x + offset.x, orig.y + offset.y, orig.z + offset.z);
          } else {
            child.position.copy(orig);
          }
        }
      });
    }
  </script>

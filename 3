<!DOCTYPE html>
<html lang="es" class="bg-[#191A1E]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cabecera Modular Dúo - La Biblia del Artesano</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold: { 300: '#FCE788', 400: '#F3E5AB', 500: '#D4AF37', 600: '#AA820A', 700: '#856404' },
            silver: { 300: '#E0E0E0', 400: '#C0C0C0', 500: '#A0A0A0', 600: '#707070' },
            dark: { 900: '#0B0C10', 800: '#12141C', 700: '#1C1F2B', 600: '#282C3D' }
          },
          boxShadow: {
            'gold-glow': '0 0 14px rgba(212, 175, 55, 0.3)',
            'silver-glow': '0 0 10px rgba(192, 192, 192, 0.2)',
            'red-glow': '0 0 15px rgba(220, 38, 38, 0.5)'
          }
        }
      }
    }
  </script>

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Three.js + OrbitControls -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
    
    html, body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      scrollbar-width: none; 
      -ms-overflow-style: none;
    }

    ::-webkit-scrollbar { display: none; }

    .faq-scroll {
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .faq-scroll::-webkit-scrollbar { display: none; }

    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
      opacity: 0;
    }
    .accordion-content.active {
      max-height: 4000px;
      opacity: 1;
    }

    #part-info-card {
      left: 50%;
      transform-origin: bottom center;
      transform: translateY(150%) translateX(-50%);
      opacity: 0;
    }
    .info-card-visible {
      transform: translateY(0) translateX(-50%) !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    
    .list-panel-open {
      display: flex !important;
      animation: fadeInDown 0.2s ease-out forwards;
    }
    
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    details > summary { list-style: none; outline: none; }
    details > summary::-webkit-details-marker { display: none; }
    
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .animate-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .chat-bubble::before {
      content: '';
      position: absolute;
      top: -5px;
      left: 20px;
      border-width: 0 5px 5px 5px;
      border-style: solid;
      border-color: transparent transparent #0B0C10 transparent; 
    }

    :root {
        --bg-dark: #191A1E; 
        --bg-card: #121212; 
        --bg-accent: #1a1a1a;
        --gold: #fdb813;
        --gold-light: #ffe066;
        --gold-gradient: linear-gradient(135deg, #ffe066 0%, #fdb813 50%, #c98a00 100%);
        --gold-border: rgba(253, 184, 19, 0.7);
        --gold-glow: rgba(253, 184, 19, 0.35);
    }

    .header-container {
        width: 100%;
        background-color: var(--bg-card);
        border: 1px solid var(--gold-border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.5), 0 0 15px var(--gold-glow);
    }

    .top-brand {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 16px; background-color: #070707; border-bottom: 1px solid var(--gold-border);
    }

    .logo-box {
        width: 38px; height: 38px; background: var(--gold-gradient); border-radius: 6px;
        display: flex; align-items: center; justify-content: center; box-shadow: 0 0 8px var(--gold-glow);
        padding: 2px; flex-shrink: 0;
    }

    .brand-text {
        font-size: 11.5px; font-weight: 800; letter-spacing: 0.5px; color: var(--gold-light);
        text-transform: uppercase; text-shadow: 0 0 6px rgba(253, 184, 19, 0.4);
    }

    .hero-image-wrapper { position: relative; width: 100%; height: 290px; background-color: #000; display: flex; align-items: center; justify-content: center; }
    .hero-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.95; }
    .hero-overlay { position: absolute; bottom: 0; left: 0; right: 0; height: 100px; background: linear-gradient(0deg, var(--bg-card) 0%, rgba(18,18,18,0) 100%); pointer-events: none; }
    .content-body { padding: 18px 20px 22px 20px; position: relative; z-index: 10; }
    
    .spec-card {
        background-color: var(--bg-accent); border: 1px solid var(--gold-border); border-radius: 10px;
        aspect-ratio: 1 / 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 8px; text-align: center; position: relative; overflow: hidden;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.4), 0 3px 8px rgba(0, 0, 0, 0.3);
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .spec-card:hover { transform: translateY(-2px); border-color: var(--gold-light); box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.5), 0 0 12px var(--gold-glow); }
    .spec-card::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2.5px; background: var(--gold-gradient); }

    @media (max-width: 650px) {
        .hero-image-wrapper { height: 220px; }
        .spec-card { padding: 6px; }
    }
  </style>
</head>
<body class="bg-[#191A1E] text-slate-100 pb-8 pt-2 selection:bg-gold-500 selection:text-black">

  <div class="w-full max-w-[1400px] mx-auto px-1 sm:px-2 lg:px-4 mb-4 mt-1">
      <div class="header-container" id="main-header">
          
          <div class="top-brand">
              <div class="brand-left gap-3">
                  <div class="logo-box">
                      <img src="https://i.ibb.co/SDwC5YCb/IMG-20260305-231115-415.png" alt="Logo La Biblia del Artesano" onerror="this.onerror=null; this.src='https://placehold.co/120x120/141414/fdb813?text=BA';"/>
                  </div>
                  <div class="flex items-center gap-1.5">
                      <span class="brand-text">LA BIBLIA DEL ARTESANO</span>
                  </div>
              </div>
              <div class="flex flex-col items-center justify-center gap-1 bg-gold-500/15 border border-gold-500/70 py-1.5 px-3 rounded-lg shadow-gold-glow">
                  <div class="flex gap-0.5 text-gold-500 text-[9px]" id="stars-container"></div>
                  <span class="text-[10px] text-gold-300 font-bold tracking-wide" id="rating-text">4.8 / 5</span>
              </div>
          </div>

          <div class="hero-image-wrapper">
              <img src="https://i.ibb.co/TB0tmfT8/Gemini-Generated-Image-9et19n9et19n9et1-2.png" alt="Cabecera Modular Dúo" class="hero-img" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=1200&q=80';"/>
              <div class="hero-overlay"></div>
          </div>

          <div class="content-body">
              <h1 class="text-xl md:text-2xl font-extrabold text-white leading-tight mb-2.5 uppercase tracking-wide">CABECERA MODULAR "DÚO" CON VELADORES INTEGRADOS</h1>
              <p class="text-[13px] text-gray-400 leading-relaxed mb-6">
                  Diseño moderno y original que combina una amplia cabecera de paneles horizontales con acento en madera y dos sólidos cajoneros laterales. Estructura minimalista, optimización de material y estilo contemporáneo para camas de 2 plazas.
              </p>

              <div class="grid grid-cols-3 gap-2.5 w-full">
                  <div class="spec-card">
                      <div class="w-8 h-8 rounded-full bg-gold-500/15 border border-gold-500/70 flex items-center justify-center mb-1.5 text-gold-400 text-[12px] shadow-gold-glow">
                          <i class="fa-solid fa-gear"></i>
                      </div>
                      <span class="text-[8px] sm:text-[9px] text-gray-500 font-bold uppercase tracking-wide mb-1">Especialidad</span>
                      <span class="text-[10px] sm:text-[11px] md:text-[12px] font-extrabold text-gold-300 leading-tight drop-shadow-md">Muebles de Dormitorio</span>
                  </div>
                  <div class="spec-card">
                      <div class="w-8 h-8 rounded-full bg-gold-500/15 border border-gold-500/70 flex items-center justify-center mb-1.5 text-gold-400 text-[12px] shadow-gold-glow">
                          <i class="fa-solid fa-layer-group"></i>
                      </div>
                      <span class="text-[8px] sm:text-[9px] text-gray-500 font-bold uppercase tracking-wide mb-1">Dificultad</span>
                      <span class="text-[10px] sm:text-[11px] md:text-[12px] font-extrabold text-gold-300 leading-tight drop-shadow-md">Avanzado</span>
                  </div>
                  <div class="spec-card">
                      <div class="w-8 h-8 rounded-full bg-gold-500/15 border border-gold-500/70 flex items-center justify-center mb-1.5 text-gold-400 text-[12px] shadow-gold-glow">
                          <i class="fa-regular fa-clock"></i>
                      </div>
                      <span class="text-[8px] sm:text-[9px] text-gray-500 font-bold uppercase tracking-wide mb-1">Tiempo Est.</span>
                      <span class="text-[10px] sm:text-[11px] md:text-[12px] font-extrabold text-gold-300 leading-tight drop-shadow-md">8 a 10 Horas</span>
                  </div>
              </div>
          </div>
      </div>
  </div>

  <main class="w-full max-w-[1400px] mx-auto px-1 sm:px-2 lg:px-4 flex flex-col lg:flex-row gap-4 relative">

    <!-- COLUMNA IZQUIERDA (Visor 3D) -->
    <div class="w-full lg:w-3/5 flex-shrink-0 space-y-4">
      
      <div class="border border-gold-500/30 rounded-lg bg-dark-800/80 overflow-hidden shadow-lg animate-on-scroll">
        <button onclick="toggleAccordion('acc-plano')" class="w-full p-3.5 flex items-center justify-between bg-gradient-to-r from-dark-800 via-dark-700 to-dark-800 border-b border-gold-500/20 text-left active:scale-[0.99] transition-transform">
          <div class="flex items-center space-x-3.5">
            <div class="p-2 rounded-lg bg-gold-500/10 border border-gold-500/30 text-gold-400">
              <i data-lucide="mouse-pointer-click" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-sm font-extrabold text-slate-100 flex items-center gap-1.5 uppercase tracking-wide">
                Proyecto Completo
              </h2>
              <span class="text-[11px] text-gold-500 font-medium block">Plano Interactivo 3D</span>
            </div>
          </div>
          <i id="icon-acc-plano" data-lucide="chevron-down" class="w-5 h-5 text-gold-400 transition-transform duration-300"></i>
        </button>

        <div id="acc-plano" class="accordion-content active">
          <div class="p-2 space-y-2">
            <div class="relative w-full h-[380px] lg:h-[600px] bg-slate-950 rounded-md overflow-hidden border border-slate-800 shadow-inner group">
              <div id="canvas-container" class="w-full h-full relative cursor-pointer"></div>
              
              <div class="absolute top-2 left-2 flex flex-col gap-1.5 z-20">
                <button onclick="reset3DView()" class="bg-dark-800/90 hover:bg-dark-700 text-gold-400 border border-gold-500/40 px-3 py-1.5 rounded text-[11px] font-bold flex items-center justify-center gap-1.5 shadow-md backdrop-blur transition-colors">
                  <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Reset
                </button>
                <button onclick="togglePasosList()" class="bg-dark-800/90 hover:bg-dark-700 text-gold-400 border border-gold-500/40 px-3 py-1.5 rounded text-[11px] font-bold flex items-center justify-center gap-1.5 shadow-md backdrop-blur transition-colors">
                  <i data-lucide="footprints" class="w-4 h-4"></i> Pasos
                </button>
                <div id="pasos-list-panel" class="hidden flex-col gap-1 bg-dark-900/95 border border-gold-500/30 p-1.5 rounded-md shadow-xl backdrop-blur-md max-h-[240px] overflow-y-auto w-[150px]">
                  <div id="pasos-list-container" class="flex flex-col gap-1"></div>
                </div>
              </div>

              <div class="absolute top-2 right-2 z-20 flex flex-col items-end gap-1.5">
                <button id="btn-explode" onclick="toggleExplodedView()" class="bg-dark-800/90 hover:bg-dark-700 text-slate-200 border border-silver-500/40 px-3 py-1.5 rounded text-[11px] font-bold flex items-center justify-center gap-1.5 shadow-md backdrop-blur transition-colors">
                  <i data-lucide="move-3d" class="w-4 h-4 text-gold-400"></i> Desarmar
                </button>
                <button onclick="togglePartsList()" class="bg-dark-800/90 hover:bg-dark-700 text-gold-400 border border-gold-500/50 px-3 py-1.5 rounded text-[11px] font-bold flex items-center justify-center gap-1.5 shadow-md backdrop-blur transition-colors">
                  <i data-lucide="list-tree" class="w-4 h-4"></i> Piezas
                </button>
                <div id="parts-list-panel" class="hidden flex-col gap-1 bg-dark-900/95 border border-gold-500/30 p-1.5 rounded-md shadow-xl backdrop-blur-md max-h-[240px] overflow-y-auto w-[180px]">
                  <div class="text-[8px] uppercase tracking-widest text-silver-400 font-bold mb-1 px-1 border-b border-slate-700 pb-1">Selecciona una pieza:</div>
                  <div id="parts-list-container" class="flex flex-col gap-1"></div>
                </div>
              </div>

              <!-- Tarjeta de Info de Pieza -->
              <div id="part-info-card" class="absolute bottom-2.5 left-1/2 w-[94%] max-w-[420px] bg-dark-900/95 border border-gold-500/60 rounded-lg p-3 shadow-2xl backdrop-blur-md transition-all duration-400 z-10 pointer-events-none">
                <button onclick="resetSelection()" class="absolute top-2 right-2 text-silver-400 hover:text-white bg-dark-800 p-1.5 rounded-md border border-slate-700 transition-colors z-20">
                  <i data-lucide="x" class="w-4 h-4"></i>
                </button>
                <div class="flex justify-between items-center mb-2.5 border-b border-slate-800 pb-2 pr-6">
                  <div class="flex items-center gap-2.5">
                    <span id="info-id-badge" class="w-5 h-5 rounded bg-gold-500 text-dark-900 font-black flex items-center justify-center text-[11px]">1</span>
                    <h3 id="info-name" class="text-xs font-black text-gold-400 leading-tight">Nombre</h3>
                  </div>
                  <div class="text-right">
                    <span id="info-qty" class="text-[11px] bg-gold-500/20 text-gold-300 px-2 py-0.5 rounded border border-gold-500/30 font-bold inline-block">x2</span>
                  </div>
                </div>
                <div class="grid grid-cols-4 gap-2 text-center">
                  <div class="bg-dark-800/80 rounded p-1.5 border border-slate-700/50">
                    <span class="text-[9px] text-silver-400 block uppercase font-bold mb-0.5">Largo</span>
                    <span id="info-l" class="font-mono text-[11px] text-slate-100 font-black">0</span>
                  </div>
                  <div class="bg-dark-800/80 rounded p-1.5 border border-slate-700/50">
                    <span class="text-[9px] text-silver-400 block uppercase font-bold mb-0.5">Ancho</span>
                    <span id="info-a" class="font-mono text-[11px] text-slate-100 font-black">0</span>
                  </div>
                  <div class="bg-dark-800/80 rounded p-1.5 border border-slate-700/50">
                    <span class="text-[9px] text-silver-400 block uppercase font-bold mb-0.5">Grosor</span>
                    <span id="info-e" class="font-mono text-[11px] text-slate-100 font-black">18</span>
                  </div>
                  <div class="bg-dark-800/80 rounded p-1.5 border border-slate-700/50 flex flex-col justify-center items-center">
                    <span class="text-[9px] text-silver-400 block uppercase font-bold mb-0.5">Tapa</span>
                    <strong id="info-tap" class="text-[10px] text-gold-400 truncate w-full">G D D D</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- COLUMNA DERECHA LISTAS -->
    <div class="w-full lg:w-2/5 flex flex-col gap-3.5 pb-8">
      
      <div class="border border-gold-500/30 rounded-lg bg-dark-800/80 overflow-hidden shadow-sm animate-on-scroll" style="transition-delay: 50ms;">
        <button onclick="toggleAccordion('acc-accesorios')" class="w-full p-3 flex items-center justify-between bg-dark-800 border-b border-gold-500/20 text-left active:bg-dark-700 transition-colors">
          <div class="flex items-center gap-3">
            <div class="p-1.5 rounded bg-gold-500/10 text-gold-400"><i data-lucide="package" class="w-4 h-4"></i></div>
            <h2 class="text-[13px] font-bold text-slate-100 uppercase tracking-wide">Accesorios</h2>
          </div>
          <i id="icon-acc-accesorios" data-lucide="chevron-down" class="w-4 h-4 text-gold-400 transition-transform duration-300"></i>
        </button>
        <div id="acc-accesorios" class="accordion-content">
          <div class="p-3 space-y-2">
            <div class="flex items-center p-2.5 rounded bg-dark-900 border border-slate-700">
              <div class="w-8 h-8 rounded bg-slate-800 text-gold-400 flex items-center justify-center mr-3 shrink-0"><i data-lucide="sliders-horizontal" class="w-4 h-4"></i></div>
              <div class="flex-1"><span class="text-xs font-bold text-slate-100 block">Correderas Telescópicas</span><span class="text-[10px] text-silver-400">350 mm</span></div>
              <span class="text-[10px] bg-gold-500/10 text-gold-400 font-bold px-2.5 py-1 rounded border border-gold-500/30">2 PARES</span>
            </div>
            <div class="flex items-center p-2.5 rounded bg-dark-900 border border-slate-700">
              <div class="w-8 h-8 rounded bg-slate-800 text-gold-400 flex items-center justify-center mr-3 shrink-0"><i data-lucide="grip-horizontal" class="w-4 h-4"></i></div>
              <div class="flex-1"><span class="text-xs font-bold text-slate-100 block">Jalador Frontal</span><span class="text-[10px] text-silver-400">Metálico</span></div>
              <span class="text-[10px] bg-gold-500/10 text-gold-400 font-bold px-2.5 py-1 rounded border border-gold-500/30">2 UNIDS</span>
            </div>
            <div class="flex items-center p-2.5 rounded bg-dark-900 border border-slate-700">
              <div class="w-8 h-8 rounded bg-slate-800 text-silver-300 flex items-center justify-center mr-3 shrink-0"><i data-lucide="circle-dot" class="w-4 h-4"></i></div>
              <div class="flex-1"><span class="text-xs font-bold text-slate-100 block">Tornillos 4 x 50</span><span class="text-[10px] text-silver-400">Para ensamble</span></div>
              <span class="text-[10px] bg-slate-800 text-silver-300 font-bold px-2.5 py-1 rounded border border-slate-600">100 U.</span>
            </div>
            <div class="flex items-center p-2.5 rounded bg-dark-900 border border-slate-700">
              <div class="w-8 h-8 rounded bg-slate-800 text-silver-300 flex items-center justify-center mr-3 shrink-0"><i data-lucide="disc" class="w-4 h-4"></i></div>
              <div class="flex-1"><span class="text-xs font-bold text-slate-100 block">Tornillos 4 x 30</span><span class="text-[10px] text-silver-400">Para correderas</span></div>
              <span class="text-[10px] bg-slate-800 text-silver-300 font-bold px-2.5 py-1 rounded border border-slate-600">20 U.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="border border-gold-500/30 rounded-lg bg-dark-800/80 overflow-hidden shadow-md animate-on-scroll" style="transition-delay: 100ms;">
        <button onclick="toggleAccordion('acc-herramientas')" class="w-full p-3 flex items-center justify-between bg-dark-800 border-b border-gold-500/20 text-left active:bg-dark-700 transition-colors">
          <div class="flex items-center gap-3">
            <div class="p-1.5 rounded bg-gold-500/10 text-gold-400"><i data-lucide="wrench" class="w-4 h-4"></i></div>
            <h2 class="text-[13px] font-bold text-slate-100 uppercase tracking-wide">Herramientas</h2>
          </div>
          <i id="icon-acc-herramientas" data-lucide="chevron-down" class="w-4 h-4 text-gold-400 transition-transform duration-300"></i>
        </button>
        <div id="acc-herramientas" class="accordion-content">
          <div class="p-3 grid grid-cols-2 gap-2">
            <div class="bg-dark-900 border border-slate-700 p-3 rounded flex flex-col items-center text-center gap-2">
              <div class="w-9 h-9 rounded-full bg-slate-800 text-gold-400 flex items-center justify-center"><i data-lucide="drill" class="w-4.5 h-4.5"></i></div>
              <span class="text-[11px] font-bold text-slate-100 leading-tight">Atornillador Inal.</span>
            </div>
            <div class="bg-dark-900 border border-slate-700 p-3 rounded flex flex-col items-center text-center gap-2">
              <div class="w-9 h-9 rounded-full bg-slate-800 text-silver-300 flex items-center justify-center"><i data-lucide="pen-tool" class="w-4.5 h-4.5"></i></div>
              <span class="text-[11px] font-bold text-slate-100 leading-tight">Puntilla Pz2</span>
            </div>
            <div class="bg-dark-900 border border-slate-700 p-3 rounded flex flex-col items-center text-center gap-2">
              <div class="w-9 h-9 rounded-full bg-slate-800 text-silver-300 flex items-center justify-center"><i data-lucide="magnet" class="w-4.5 h-4.5"></i></div>
              <span class="text-[11px] font-bold text-slate-100 leading-tight">Extensión Imant.</span>
            </div>
            <div class="bg-dark-900 border border-slate-700 p-3 rounded flex flex-col items-center text-center gap-2">
              <div class="w-9 h-9 rounded-full bg-slate-800 text-silver-300 flex items-center justify-center"><i data-lucide="ruler" class="w-4.5 h-4.5"></i></div>
              <span class="text-[11px] font-bold text-slate-100 leading-tight">Wincha / Esquad.</span>
            </div>
          </div>
